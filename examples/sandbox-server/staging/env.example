# orascout environment file. Loaded by systemd's EnvironmentFile= directive
# in /etc/systemd/system/orascout.service. Keep chmod 600.
#
# REGISTRY_TOKEN is a Personal Access Token (PAT), NOT your account password.
#   - Docker Hub:  Account Settings -> Security -> New Access Token
#                  (any scope works for read; "Read & Write" for push too).
#   - GHCR:        Settings -> Developer settings -> Personal access tokens.
#                  Fine-grained PAT with `read:packages` (push needs write).
#   - Harbor:      use a robot account credential.
#
# The PAT goes in the basic-auth password slot under the hood; that's the
# convention Docker Hub and GHCR use. If your registry instead issues
# real bearer tokens (some Harbor setups, OAuth flows), see the comment
# in config.yaml about switching to the `token:` field.
REGISTRY_USERNAME=CHANGE_ME
REGISTRY_TOKEN=CHANGE_ME
