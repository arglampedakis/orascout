# Test-runner image: Go + oras CLI + jq + bash + curl, used by the `e2e`
# service in test/docker-compose.yml.
#
# This image is for testing only. The production image is the top-level
# Dockerfile (smaller, no test tooling).

FROM golang:1.25-alpine

# The oras CLI is copied from the official release image rather than
# downloaded with wget/curl inside the build: image pulls go through the
# Docker daemon, which works in environments where BuildKit's own network
# is restricted (corporate proxies/VPNs), and the version is pinned by tag.
COPY --from=ghcr.io/oras-project/oras:v1.2.0 /bin/oras /usr/local/bin/oras

RUN apk add --no-cache \
      bash \
      jq \
      curl \
      ca-certificates \
    && oras version

WORKDIR /src

# Source is bind-mounted by docker-compose so we don't COPY here. Just run
# the test script as the container's CMD.
CMD ["bash", "test/e2e.sh"]
